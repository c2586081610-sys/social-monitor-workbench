# 博主监控工作台 · 环境配置
# 复制为 .env 并修改后使用（本文件为示例，生产配置勿提交）

# --- 认证 ---
ADMIN_TOKEN=dev-admin-token-change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 存储路径（默认在工作区根，可自定义） ---
# DATABASE_PATH=
# MEDIA_ROOT=
# OBSIDIAN_ROOT=
# WORKBUDDY_DIR=

# --- 监控层调度 ---
POLL_RSSHUB_INTERVAL=300
POLL_DOUYIN_INTERVAL=600
POLL_TRIGGER_INTERVAL=10
HEARTBEAT_INTERVAL=15

# --- 外部服务（自建实例地址，留空视为未配置） ---
# RSSHUB_BASE_URL=http://127.0.0.1:1200
# CHANGEDETECTION_URL=http://127.0.0.1:5000

# --- 流水线开关（核心） ---
# true=启用真实流水线（下载→转写→抽帧→WorkBuddy 清单），false=仅监控不入流水线
MONITOR_RUN_PIPELINE=true
# 转写引擎：funasr（SenseVoice）已安装验证；留空=使用默认
TRANSCRIBER_ENGINE=funasr

# --- 抖音 CDP（P2，需 Patchright 会话） ---
ENABLE_DOUYIN_CDP=false
# DOUYIN_CDP_PROFILE_DIR=

# --- 下载器（P1 使用 CLI 子进程；jiji262/yutto 等按 SPEC §3.2 安装后配置） ---
# DOWNLOADER_BIN=
