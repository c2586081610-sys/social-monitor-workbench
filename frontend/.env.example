# 前端环境变量示例（复制为 .env.development 使用；Vite 仅暴露 VITE_ 前缀变量）

# 聚合 API 基地址（默认 http://127.0.0.1:8000，CORS 已放行 5173）
VITE_API_BASE_URL=http://127.0.0.1:8000

# 开发期默认 ADMIN_TOKEN（可选；不设则兜底 dev-admin-token-change-me）
# 后端变更 ADMIN_TOKEN 后，可在页面「设置 → API 连接与口令」覆盖（存 localStorage）
VITE_ADMIN_TOKEN=dev-admin-token-change-me
